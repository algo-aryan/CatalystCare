# CatalystCare Environment Variables Template
# Copy to .env.local for local execution

# Session Encryption (Min 32 characters)
SESSION_SECRET=catalystcare_super_secure_production_secret_key_32chars!

# CareLink Token HMAC Key
CARELINK_HMAC_SECRET=carelink_token_cryptographic_secret_key_9988!

# Google Gemini API Key (Optional for clinical drug interactions, degrades gracefully)
GEMINI_API_KEY=your_gemini_api_key_here

# Sarvam AI API Key (Optional: powers Indic neural TTS via Sarvam AI 'bulbul:v1' model)
SARVAM_API_KEY=your_sarvam_api_key_here

# Notification Mailer (Optional: uses in-memory / simulated outbox viewer if unset)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CatalystCare Alerts <alerts@catalystcare.org>"

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
